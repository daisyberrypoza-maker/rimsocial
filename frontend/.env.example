# Copy to .env.development.local (dev) or .env.production.local (release builds).
# Leave empty for local development (Vite proxies /v1 to localhost:3000).
# For separately hosted web builds and Android/iOS, set this to the deployed API origin, e.g. https://api.example.com.
# Do not include /v1 at the end.
VITE_API_URL=

# Google Cloud OAuth 2.0 Web client ID (must match backend GOOGLE_CLIENT_ID)
VITE_GOOGLE_CLIENT_ID=
