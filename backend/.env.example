PORT=3000
JWT_SECRET=YOUR_NEW_RANDOM_SECRET_OF_AT_LEAST_32_CHARACTERS

DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=clipverse
DB_USER=root
DB_PASS=

REDIS_URL=redis://127.0.0.1:6379
PAYSTACK_SECRET=sk_test_YOUR_TEST_SECRET
GOOGLE_CLIENT_ID=
ADMIN_API_KEY=YOUR_DIFFERENT_RANDOM_SECRET
UPLOAD_DIR=uploads
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,https://localhost,capacitor://localhost,ionic://localhost
# In production add your real frontend origin(s), separated by commas. Explicit wildcard example: https://*.vercel.app
SERVE_FRONTEND=false
TRUST_PROXY=0
# Development defaults create/sync the database. Production should use migrations and set both false.
AUTO_CREATE_DATABASE=true
DB_SYNC=true
NODE_ENV=development
# Cloudinary media storage (required for post/story/avatar uploads)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
# Money settings (optional). The values below are the defaults; amounts are minor units (kobo).
# Changes apply only to new purchases, gifts and payouts.
# COIN_PRICE_MINOR=100
# COIN_VALUE_MINOR=100
# CREATOR_GIFT_SHARE=0.5
# PAYOUT_HOLD_DAYS=7
# MIN_PAYOUT_MINOR=500000
# Hours before an unanswered LIVE match invitation expires
# MATCH_INVITE_TTL_HOURS=24

# WebRTC TURN relay (recommended for mobile networks). Use a coturn deployment with use-auth-secret.
# Comma-separated URLs, e.g. TURN_URLS=turn:turn.example.com:3478,turns:turn.example.com:5349
TURN_URLS=
# Set the coturn static-auth-secret here; server issues one-hour credentials per authenticated match participant.
TURN_SECRET=
# Optional fallback only if your TURN provider requires fixed credentials (prefer TURN_SECRET).
TURN_USERNAME=
TURN_PASSWORD=

# Public LIVE broadcasts (LiveKit SFU). Keep API secret server-side only.
# Example URL: wss://your-project.livekit.cloud
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
